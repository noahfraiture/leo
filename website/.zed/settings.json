// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "project_name": "Video Analysis",
  "lsp_document_colors": "inlay",
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "files": {
          "exclude": [
            "**/.direnv/**",
            "**/.data/**",
            "**/backend/target/**"
          ],
        },
        "colorDecorators": true,
        "hovers": true,
        "suggestions": true,
        "codeActions": true,
        "validate": true,
        "classAttributes": ["class"],
        "includeLanguages": {
          "Rust": "html",
          "rust": "html",
        },
        "experimental": {
          "configFile": {
            "/Users/noah/Projects/leo/website/backend/src/http/ui/styles.css": [
              "/Users/noah/Projects/leo/website/backend/src/http/ui/**",
            ],
          },
          "classRegex": [
            "class\\s*=\\s*\"([^\"]*)\"",
            "class\\s*=\\s*'([^']*)'",
          ],
        },
      },
    },
  },
  "languages": {
    "Rust": {
      "language_servers": ["tailwindcss-language-server", "rust-analyzer"],
    },
  },
}
