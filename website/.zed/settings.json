// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "project_name": "Babylon",
  "lsp_document_colors": "inlay",
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "files": {
          "exclude": ["**/.direnv/**"],
        },
        "colorDecorators": true,
        "hovers": true,
        "suggestions": true,
        "codeActions": true,
        "validate": true,
        "classAttributes": ["class"],
        "includeLanguages": {
          "Rust": "html",
          "rust": "html",
        },
        "experimental": {
          "configFile": {
            "/Users/noah/Projects/babylon/frontend/src/app.css": [
              "/Users/noah/Projects/babylon/frontend/src/**",
              "/Users/noah/Projects/babylon/backend/src/http/ui/**",
            ],
          },
          "classRegex": [
            "class\\s*=\\s*\"([^\"]*)\"",
            "class\\s*=\\s*'([^']*)'",
          ],
        },
      },
    },
  },
  "languages": {
    "Rust": {
      "language_servers": ["tailwindcss-language-server", "rust-analyzer"],
    },
  },
}
